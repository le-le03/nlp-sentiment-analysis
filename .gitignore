# .gitignore文件
cat > .gitignore << 'EOF'
# 模型文件
*.h5
*.keras
*.pkl
*.joblib
*.model
*.pb

# 模型权重和变量
variables/
saved_model.pb
keras_metadata.pb

# 整个模型目录（重要！）
src/models/

# 数据文件
*.csv
*.json
*.npy
data/
raw_data/

# 结果文件（如果太大也可以忽略）
src/results/

# 日志文件
*.log
logs/
tensorboard_logs/

# 环境配置
.env
.venv
venv/
env/

# IDE文件
.vscode/
.idea/
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db

# Python缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# Jupyter笔记本
.ipynb_checkpoints/
EOF